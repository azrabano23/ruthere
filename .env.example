# ---- server ----
PORT=4000
# Leave DATABASE_URL empty to run with the in-memory store (no setup needed).
# Set it to your Supabase/Postgres connection string to persist data.
DATABASE_URL=
# Leave empty in dev: sign-in codes are printed to the server console.
# Free Brevo account (300 emails/day). EMAIL_FROM must be a sender you verified in Brevo;
# with a Gmail sender, Brevo shows the email as coming from a brevosend.com address.
BREVO_API_KEY=
EMAIL_FROM=RUThere <your-verified-sender@gmail.com>
# Only scarletmail addresses can sign in.
ALLOWED_EMAIL_DOMAINS=scarletmail.rutgers.edu
SESSION_SECRET=change-me-in-prod
# Comma-separated Rutgers emails allowed to approve drivers.
ADMIN_EMAILS=
CLIENT_ORIGIN=http://localhost:5173

# ---- client (Vite only exposes VITE_* vars) ----
VITE_API_URL=http://localhost:4000
# Leave empty to use the built-in list of campus pickup spots instead of Google Places.
VITE_GOOGLE_MAPS_KEY=
