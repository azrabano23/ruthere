# ---- server ----
PORT=4000
# Leave DATABASE_URL empty to run with the in-memory store (no setup needed).
# Set it to your Supabase/Postgres connection string to persist data.
DATABASE_URL=
# Leave empty in dev: sign-in codes are printed to the server console.
# Until we verify a domain in Resend, onboarding@resend.dev only delivers to the
# email that owns the Resend account; everyone else gets "We couldn't email your code".
RESEND_API_KEY=
EMAIL_FROM=RUThere <onboarding@resend.dev>
ALLOWED_EMAIL_DOMAINS=rutgers.edu,scarletmail.rutgers.edu
SESSION_SECRET=change-me-in-prod
CLIENT_ORIGIN=http://localhost:5173

# ---- client (Vite only exposes VITE_* vars) ----
VITE_API_URL=http://localhost:4000
# Leave empty to use the built-in list of campus pickup spots instead of Google Places.
VITE_GOOGLE_MAPS_KEY=
